# Puerto local, credenciales SQL y datos que usarán los tokens JWT.
# Este archivo contiene ejemplos; los valores reales se guardan en .env.
HTTP_PORT=8080
DB_ROOT_PASSWORD=replace_with_a_strong_root_password
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=replace_with_a_unique_password
INVENTARIO_DB_USER=inventario_app
INVENTARIO_DB_PASSWORD=replace_with_another_unique_password
JWT_ISSUER=pos-ferreteria-auth
JWT_AUDIENCE=pos-ferreteria-api
JWT_TTL=900
# Ventas usa una cuenta propia y una clave interna distinta a las contraseñas SQL.
VENTAS_DB_USER=ventas_app
VENTAS_DB_PASSWORD=replace_with_a_unique_sales_password
VENTAS_INTERNAL_KEY=replace_with_a_random_internal_key

# Réplica y consulta gráfica. El script prepare-replication-env.ps1 genera secretos locales.
REPLICATION_USER=ferresync_repl
REPLICATION_PASSWORD=replace_with_a_unique_replication_password
REPLICA_ROOT_PASSWORD=replace_with_a_unique_replica_root_password
REPORTS_DB_USER=ventas_lectura
REPORTS_DB_PASSWORD=replace_with_a_unique_readonly_password
DB_VIEWER_USER=ferresync_consulta
DB_VIEWER_PASSWORD=replace_with_a_unique_viewer_password

# OpenWeatherMap: completar con una clave propia, nunca publicarla.
OPENWEATHER_API_KEY=
WEATHER_LAT=14.6349
WEATHER_LON=-90.5069

# Solo credenciales de una aplicación Sandbox de PayPal. No usa producción.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_USD_RATE=7.80
PAYPAL_RETURN_URL=http://localhost:8080/pago-retorno.html
